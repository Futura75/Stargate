# Copy to .env.local (never commit it) and fill in from Supabase → Project Settings → API.
# Both values are public by design: the anon/publishable key only works within the
# Row Level Security policies in supabase/schema.sql. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
